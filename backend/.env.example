# Lokal geliştirme için backend/.env olarak kopyala.
# Vercel'de aynı değişkenleri Project Settings > Environment Variables'a gir.

NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role / secret anahtar: SADECE backend. Frontend'e asla koyma.
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth ---
JWT_SECRET=uzun-rastgele-bir-deger
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
# İsteğe bağlı: realtime kanal adları için ayrı sır (yoksa JWT_SECRET kullanılır)
REALTIME_CHANNEL_SECRET=
GOOGLE_CLIENT_ID=

# --- Görseller ---
# Ürün ve slider görselleri Supabase Storage "media" bucket'ında; ek ayar gerekmez.

# --- E-posta (SMTP veya Resend) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# MAIL_PROVIDER=resend
# RESEND_API_KEY=
# RESEND_FROM=

# --- PayTR ---
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true

# --- Seeder (npm run seed) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
