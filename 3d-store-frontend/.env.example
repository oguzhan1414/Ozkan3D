# 3d-store-frontend/.env olarak kopyala. Vercel'de de aynı isimlerle gir.

# Boş bırak: API aynı domainde /api altında (lokalde Vite proxy'si :5000'e yönlendirir)
VITE_API_URL=

VITE_GOOGLE_CLIENT_ID=

# Supabase Realtime bildirimleri için (Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
# anon / publishable anahtar (herkese açık olabilir; tablolar RLS ile kapalı)
VITE_SUPABASE_PUBLISHABLE_KEY=
