{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix backend && npm ci --include=dev --prefix 3d-store-frontend",
  "buildCommand": "npm run build --prefix 3d-store-frontend",
  "outputDirectory": "3d-store-frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "backend/templates/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/storage-cleanup",
      "schedule": "0 4 * * 1"
    }
  ]
}
